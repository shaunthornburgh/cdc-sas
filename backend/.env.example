APP_NAME="Casa Dolce Casa API"
ENVIRONMENT=local
DEBUG=true

# Matches docker-compose.yml (Postgres on localhost:5432)
DATABASE_URL=postgresql+psycopg://cdc:cdc@localhost:5432/cdc
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# JWT (not used yet, wired for the auth step)
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-please
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
